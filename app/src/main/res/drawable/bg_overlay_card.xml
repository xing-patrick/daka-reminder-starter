<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈模拟阴影（悬浮窗里 elevation 通常不生效，用 layer-list 手工做） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/c_surface" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/c_stroke" />
        </shape>
    </item>
</layer-list>
