<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/edit_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/edit_time_label"
            android:textColor="@color/c_text_dim"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_time"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="08:00"
            android:textSize="19sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/edit_kind_label"
            android:textColor="@color/c_text_dim"
            android:textSize="12sp" />

        <!-- 类型：重复 / 单日 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/seg_repeat"
                style="@style/SegItem"
                android:layout_marginEnd="8dp"
                android:text="@string/kind_repeat" />

            <TextView
                android:id="@+id/seg_once"
                style="@style/SegItem"
                android:text="@string/kind_once" />
        </LinearLayout>

        <!-- 重复：排期规则 -->
        <LinearLayout
            android:id="@+id/block_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rule_mode_label"
                android:textColor="@color/c_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mode_everyday"
                    style="@style/SegItem"
                    android:layout_marginEnd="6dp"
                    android:text="@string/mode_everyday" />

                <TextView
                    android:id="@+id/mode_weekday"
                    style="@style/SegItem"
                    android:layout_marginEnd="6dp"
                    android:text="@string/mode_weekday" />

                <TextView
                    android:id="@+id/mode_weekend"
                    style="@style/SegItem"
                    android:text="@string/mode_weekend" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mode_legal_workday"
                    style="@style/SegItem"
                    android:layout_marginEnd="6dp"
                    android:text="@string/mode_legal_workday" />

                <TextView
                    android:id="@+id/mode_legal_holiday"
                    style="@style/SegItem"
                    android:layout_marginEnd="6dp"
                    android:text="@string/mode_legal_holiday" />

                <TextView
                    android:id="@+id/mode_custom"
                    style="@style/SegItem"
                    android:text="@string/mode_custom" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_rule_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/c_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/block_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day1"
                    style="@style/ChipDay"
                    android:layout_marginEnd="5dp"
                    android:text="一" />

                <TextView
                    android:id="@+id/day2"
                    style="@style/ChipDay"
                    android:layout_marginEnd="5dp"
                    android:text="二" />

                <TextView
                    android:id="@+id/day3"
                    style="@style/ChipDay"
                    android:layout_marginEnd="5dp"
                    android:text="三" />

                <TextView
                    android:id="@+id/day4"
                    style="@style/ChipDay"
                    android:layout_marginEnd="5dp"
                    android:text="四" />

                <TextView
                    android:id="@+id/day5"
                    style="@style/ChipDay"
                    android:layout_marginEnd="5dp"
                    android:text="五" />

                <TextView
                    android:id="@+id/day6"
                    style="@style/ChipDay"
                    android:layout_marginEnd="5dp"
                    android:text="六" />

                <TextView
                    android:id="@+id/day7"
                    style="@style/ChipDay"
                    android:text="日" />
            </LinearLayout>
        </LinearLayout>

        <!-- 单日模板：不指定日期，说明一下怎么用 -->
        <LinearLayout
            android:id="@+id/block_once"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/once_template_hint"
                android:textColor="@color/c_text_dim"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 提醒方式：声音 / 震动，按任务单独设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/edit_alert_label"
            android:textColor="@color/c_text_dim"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/edit_sound"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_vibrate"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/edit_alert_hint"
            android:textColor="@color/c_text_dim"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
