<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/import_hint"
            android:textColor="@color/c_text_dim"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/import_quick_label"
            android:textColor="@color/c_text_dim"
            android:textSize="12sp" />

        <!-- 点一下把示例追加到输入框，不用记语法 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_everyday"
                style="@style/SegItem"
                android:layout_marginEnd="6dp"
                android:text="@string/mode_everyday" />

            <TextView
                android:id="@+id/chip_weekday"
                style="@style/SegItem"
                android:layout_marginEnd="6dp"
                android:text="@string/mode_weekday" />

            <TextView
                android:id="@+id/chip_weekend"
                style="@style/SegItem"
                android:text="@string/mode_weekend" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_legal_workday"
                style="@style/SegItem"
                android:layout_marginEnd="6dp"
                android:text="@string/mode_legal_workday" />

            <TextView
                android:id="@+id/chip_legal_holiday"
                style="@style/SegItem"
                android:layout_marginEnd="6dp"
                android:text="@string/mode_legal_holiday" />

            <TextView
                android:id="@+id/chip_once"
                style="@style/SegItem"
                android:text="@string/kind_once" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/import_hint_short">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="6"
                android:scrollbars="vertical"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_import_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/c_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
