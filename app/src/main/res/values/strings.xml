    <!-- 节假日与调休 -->
    <string name="holiday_title">节假日与调休</string>
    <string name="holiday_intro">「法定上班日」「休息日」两条规则靠这张表判断。休息日 = 周末 + 法定放假 − 调休补班，和法定上班日正好互补。优先从手机自带的节假日日历同步，读不到就手动粘贴导入。调休补班的优先级高于放假。</string>
    <string name="holiday_sync">从日历同步</string>
    <string name="holiday_import">手动导入</string>
    <string name="holiday_clear">清空</string>
    <string name="holiday_empty">还没有节假日数据\n点「从日历同步」或「手动导入」</string>
    <string name="holiday_perm_denied">没有日历权限，读不到节假日。可以点「手动导入」自己粘一份。</string>
    <string name="holiday_type_holiday">法定放假</string>
    <string name="holiday_type_workday">调休补班（要上班）</string>
    <string name="holiday_import_hint">每行一条：日期 + 休/班。支持 10月1日、2026-10-01、10/1，也支持 10/1-10/7 这样的区间。不写「班」默认按放假。</string>
    <string name="holiday_import_hint_short">例如：10月1日-10月7日 休</string>

    <!-- 持续提醒 / 手表 -->
    <string name="persistent_on">已开启：必须点「已完成」或「稍后」才会停止响铃</string>
    <string name="persistent_off">已关闭：提醒响一轮就停，卡片 15 分钟后收起</string>
    <string name="watch_title">手表 / 手环推送</string>
    <string name="watch_message">手表收的是「系统通知」，不是桌面悬浮卡片。华为手表通过「华为运动健康」把手机通知镜像到表上，通知是唯一通路，关掉通知手表就收不到。\n\n手表端只能看、不能操作：穿戴设备的通知镜像不显示按钮，在表上点通知也只是在表上查看，不会把动作回传给手机。所以通知里不放「已完成 / 放弃本次」，点手机上的那条通知也只是打开 App。打卡、稍后、放弃都在悬浮卡片上完成。</string>
    <string name="watch_open_app">打开穿戴 App 设置</string>
    <string name="watch_boost_on">开启推送增强（提高通知优先级）</string>
    <string name="watch_boost_off">关闭推送增强</string>
    <string name="watch_notify_on">开启通知（手表才能收到）</string>
    <string name="watch_notify_off">关闭通知（手表将收不到，声音震动照旧）</string>
    <string name="watch_repeat_on">开启重复提醒（每 20 秒再发一次，手表多震几轮）</string>
    <string name="watch_repeat_off">关闭重复提醒（手表只震一次）</string>
    <string name="watch_test">发一条测试通知到手表</string>
    <string name="watch_no_app">没找到穿戴 App，请到应用商店装「华为运动健康」或对应手环 App</string>
