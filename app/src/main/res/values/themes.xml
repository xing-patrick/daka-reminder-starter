<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Daka" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/c_primary</item>
        <item name="colorPrimaryVariant">@color/c_primary_dark</item>
        <item name="colorOnPrimary">@color/c_on_primary</item>
        <item name="colorSecondary">@color/c_primary</item>
        <item name="colorOnSecondary">@color/c_on_primary</item>
        <item name="colorSurface">@color/c_surface</item>
        <item name="colorOnSurface">@color/c_text</item>
        <item name="android:colorBackground">@color/c_bg</item>
        <item name="android:windowBackground">@color/c_bg</item>
        <item name="android:statusBarColor">@color/c_bg</item>
        <item name="android:navigationBarColor">@color/c_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialAlertDialogTheme">@style/Theme.Daka.Dialog</item>
    </style>

    <style name="Theme.Daka.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/c_primary</item>
        <item name="colorSurface">@color/c_surface</item>
        <item name="colorOnSurface">@color/c_text</item>
    </style>

    <!-- 小胶囊：星期选择 -->
    <style name="ChipDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/c_text</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 分段控件：重复 / 单日 -->
    <style name="SegItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/c_text</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
